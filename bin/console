#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Module-based migration runner.
 *
 *   php bin/console migrate            apply all pending module migrations
 *   php bin/console migrate:rollback   roll back the most recent batch
 *   php bin/console migrate:status     show each migration and whether it ran
 *   php bin/console oauth:client:create "<name>" [redirect_uri ...]          register a confidential client
 *   php bin/console oauth:client:create:public "<name>" <redirect_uri ...>   register a public (PKCE, no secret) client
 *   php bin/console oauth:purge        delete expired OAuth tokens
 *
 * Migrations are discovered per module (Modules/<Name>/Migrations/) from the
 * module map in config/modules.php.
 */

use bapersbw\Auth\TokenStore;
use bapersbw\Database\Connection;
use bapersbw\Database\Migrator;
use bapersbw\Logging\LoggerFactory;

require dirname(__DIR__) . '/vendor/autoload.php';

$config = require dirname(__DIR__) . '/config/config.php';
$modules = require dirname(__DIR__) . '/config/modules.php';

$command = $argv[1] ?? 'migrate:status';

$connection = new Connection((array) ($config['database'] ?? []));
$migrator = new Migrator($connection, LoggerFactory::create(['path' => 'php://stdout', 'level' => 'info'], 'console'));
$discovered = Migrator::discover($modules);

switch ($command) {
    case 'migrate':
        $ran = $migrator->migrate($discovered);
        echo $ran === [] ? "Nothing to migrate.\n" : 'Applied: ' . implode(', ', $ran) . "\n";
        break;

    case 'migrate:rollback':
        $rolled = $migrator->rollback($discovered);
        echo $rolled === [] ? "Nothing to roll back.\n" : 'Rolled back: ' . implode(', ', $rolled) . "\n";
        break;

    case 'migrate:status':
        foreach ($migrator->status($discovered) as $row) {
            printf("[%s] %s/%s\n", $row['applied'] ? 'x' : ' ', $row['module'], $row['name']);
        }
        break;

    case 'oauth:client:create':
        $name = trim((string) ($argv[2] ?? ''));
        if ($name === '') {
            fwrite(STDERR, "Usage: php bin/console oauth:client:create \"<name>\" [redirect_uri ...]\n");
            exit(1);
        }
        $redirectUris = array_slice($argv, 3); // any args after the name
        $client = (new TokenStore($connection))->createClient($name, $redirectUris);
        echo "Client created. Store the secret now — it is not shown again.\n";
        echo "  client_id:     {$client['client_id']}\n";
        echo "  client_secret: {$client['client_secret']}\n";
        if ($redirectUris !== []) {
            echo "  redirect_uris: " . implode(', ', $redirectUris) . "\n";
        }
        break;

    case 'oauth:client:create:public':
        $name = trim((string) ($argv[2] ?? ''));
        if ($name === '') {
            fwrite(STDERR, "Usage: php bin/console oauth:client:create:public \"<name>\" <redirect_uri> [redirect_uri ...]\n");
            exit(1);
        }
        $redirectUris = array_slice($argv, 3);
        if ($redirectUris === []) {
            fwrite(STDERR, "A public client needs at least one redirect_uri.\n");
            exit(1);
        }
        $client = (new TokenStore($connection))->createPublicClient($name, $redirectUris);
        echo "Public client created (no secret — uses PKCE).\n";
        echo "  client_id:     {$client['client_id']}\n";
        echo "  redirect_uris: " . implode(', ', $redirectUris) . "\n";
        break;

    case 'oauth:purge':
        // Delete expired OAuth tokens (for schedulers; MSSQL also self-purges
        // via a trigger). Clients/ttl are irrelevant to purging.
        $removed = (new TokenStore($connection))->purgeExpired();
        echo "Purged {$removed} expired token(s).\n";
        break;

    default:
        fwrite(STDERR, "Unknown command [$command].\n");
        exit(1);
}
